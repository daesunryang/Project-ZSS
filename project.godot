; Engine configuration file.
; LAST HAVEN — Godot 4.7.2 Stable project (see docs/00 ADR-001).

config_version=5

[application]

config/name="LAST HAVEN"
config/description="Zombie apocalypse survival simulation (co-op, dedicated-server authority)."
config/version="0.0.1"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

; Enforce static typing (CLAUDE.md §4, docs/09 §1): untyped declarations are errors.
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
