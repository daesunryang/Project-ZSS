[resource]
script = ExtResource("1_lines")
lines = {
"refuse_fear": PackedStringArray("오지 마세요. 더 가까이 오지 마요.", "저, 저리 가요. 할 말 없어요.", "거기 서요. 다가오지 말라고요."),
"refuse_distrust": PackedStringArray("당신하고는 할 말 없어요.", "볼일 없으니 가던 길 가요.", "말 섞고 싶지 않아요."),
"refuse_busy": PackedStringArray("지금은 안 돼요.", "나중에요. 지금 그럴 때가 아니에요."),
"refuse_again": PackedStringArray("싫다고 했잖아요. 그만 좀 해요.", "몇 번을 말해요. 가라고요."),
"asleep": PackedStringArray("(깊이 잠들어 있다.)", "(고른 숨소리가 들린다. 자고 있다.)"),
"wake_grumpy": PackedStringArray("으음... 뭐예요, 자는 사람을.", "하... 겨우 잠들었는데. 무슨 일이에요?"),
"wake_startled": PackedStringArray("으악! 누, 누구야! 저리 가!", "헉! 가까이 오지 마요!"),
"open_warm": PackedStringArray("아, 사람이네요. 반가워요.", "살아 있는 사람을 보니 좋네요. 무슨 일이에요?", "또 보네요. 잘 지냈어요?"),
"open_neutral": PackedStringArray("무슨 일이죠?", "할 말 있으면 해요.", "...네. 말해요."),
"open_cold": PackedStringArray("용건만 말해요.", "짧게 해요.", "뭡니까."),
"greet_warm": PackedStringArray("안녕하세요. 요즘 같은 때 인사 받으니 좋네요.", "네, 안녕하세요. 다친 데는 없죠?"),
"greet_neutral": PackedStringArray("...안녕하세요.", "네, 뭐. 안녕하세요."),
"greet_cold": PackedStringArray("인사는 됐어요.", "...네."),
"greet_again": PackedStringArray("아까 인사했잖아요.", "인사는 한 번이면 돼요."),
"who_open": PackedStringArray("{name}. 그게 제 이름이에요. 이 근처에서 혼자 버티고 있어요.", "제 이름은 {name}. 여기 온 지는 좀 됐어요.", "{name}. 그냥 살아남으려는 사람이에요."),
"who_guarded": PackedStringArray("{name}. 그 이상은 묻지 마요.", "이름은 {name}. 나머지는 알 것 없어요."),
"who_refuse": PackedStringArray("그걸 왜 알려 줘야 하죠?", "모르는 사람한테 내 얘기는 안 해요."),
"give_ask": PackedStringArray("...뭘 주려고요?", "주는 거라면 사양 안 해요. 뭔데요?"),
"give_nothing": PackedStringArray("줄 만한 건 없어 보이는데요.", "빈손이잖아요."),
"give_cannot": PackedStringArray("지금은 받을 수가 없어요.", "받아 둘 데가 없어요."),
"give_thanks_need": PackedStringArray("정말요? ...고마워요. 진짜 필요했어요.", "이걸 나한테? 고마워요. 잊지 않을게요.", "살았다... 고마워요."),
"give_thanks": PackedStringArray("고마워요. 잘 쓸게요.", "받을게요. 고마워요."),
"give_wary": PackedStringArray("...받기는 하겠는데, 뭘 바라는 거죠?", "공짜는 없다던데. 일단 받죠."),
"give_refuse_fear": PackedStringArray("거, 거기 두고 가요. 가까이 오지 말고.", "됐어요. 필요 없으니 가요."),
"give_full": PackedStringArray("더는 들 데가 없어요.", "가방이 꽉 찼어요. 마음만 받을게요."),
"news_danger": PackedStringArray("{dir} 방향, {dist}미터쯤 되는 데서 좀비를 봤어요. 그쪽은 피해요.", "{dir} 방향은 조심해요. {dist}미터쯤 되는 데서 좀비가 돌아다녔어요."),
"news_emptied": PackedStringArray("{dir} 방향, {dist}미터쯤에 있는 집은 내가 다 뒤졌어요. 가 봐야 빈손이에요.", "{dir} 방향 {dist}미터쯤의 집은 헛걸음이에요. 남은 게 없어요."),
"news_none": PackedStringArray("딱히 아는 게 없어요. 나도 멀리는 안 나가서.", "별일 없었어요. 조용한 게 더 무섭죠."),
"news_refuse": PackedStringArray("그런 걸 왜 당신한테 말해요?", "내가 아는 건 내가 쓸 거예요."),
"trade_ask": PackedStringArray("바꾸자고요? 뭘 내놓을 건데요.", "물건 나름이죠. 볼까요."),
"trade_nothing": PackedStringArray("바꿀 만한 게 없네요.", "서로 줄 게 없어 보여요."),
"trade_refuse": PackedStringArray("당신하고는 거래 안 해요.", "믿을 수 있어야 바꾸죠."),
"trade_done": PackedStringArray("좋아요. 그걸로 해요.", "공평하네요. 받아요."),
"trade_failed": PackedStringArray("지금은 못 바꾸겠어요.", "들 데가 없어서 안 되겠어요."),
"join_maybe": PackedStringArray("같이요? ...생각 좀 해 볼게요.", "혼자보다는 낫겠죠. 생각해 볼게요."),
"join_later": PackedStringArray("아직은 모르겠어요. 당신을 잘 모르니까.", "좀 더 지켜보고요."),
"join_no": PackedStringArray("됐어요. 혼자가 편해요.", "당신을 따라갈 일은 없을 거예요."),
"threat_cowed": PackedStringArray("아, 알았어요! 알았으니까 그러지 마요!", "하, 하지 마요... 제발 그냥 가 줘요."),
"threat_defiant": PackedStringArray("해 볼 테면 해 봐요. 나도 가만있지는 않아요.", "협박이에요? 당장 꺼져요."),
"back": PackedStringArray("다른 건요?", "또 뭐요?"),
"bye_warm": PackedStringArray("조심히 가요. 또 봐요.", "살아서 또 봅시다."),
"bye_neutral": PackedStringArray("네, 가요.", "그래요."),
"bye_cold": PackedStringArray("빨리 가요.", "다시 오지 마요."),
"enough": PackedStringArray("이 정도면 됐죠. 나도 할 일이 있어요.", "말이 길어졌네요. 이만 해요."),
